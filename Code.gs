// ============================================================
// MENU AND DIALOG
// ============================================================

function onOpen() {
  const settings = PLACEHOLDER_CONFIG.settings;

  DocumentApp.getUi()
    .createMenu(settings.menuTitle)
    .addItem(settings.menuItemTitle, 'showAutomationDialog')
    .addToUi();
}

function showAutomationDialog() {
  const settings = PLACEHOLDER_CONFIG.settings;

  const html = HtmlService.createHtmlOutputFromFile(settings.htmlFile)
    .setWidth(settings.dialogWidth)
    .setHeight(settings.dialogHeight);

  DocumentApp.getUi().showModalDialog(html, settings.dialogTitle);
}

// ============================================================
// CONFIGURATION HELPERS
// ============================================================

function getConfiguredDefaults_() {
  const settings = PLACEHOLDER_CONFIG.settings;
  const defaults = {};

  PLACEHOLDER_CONFIG.fields.forEach(field => {
    if (field.defaultValueType === 'today') {
      defaults[field.key] = Utilities.formatDate(
        new Date(),
        settings.timeZone,
        settings.dateFormat,
      );
    } else {
      defaults[field.key] = field.defaultValue ?? '';
    }
  });

  return defaults;
}

function getConfiguredPlaceholders_() {
  return PLACEHOLDER_CONFIG.fields.map(field => field.placeholder);
}

function getTabTitleDate_() {
  const settings = PLACEHOLDER_CONFIG.settings;

  return Utilities.formatDate(
    new Date(),
    settings.timeZone,
    settings.tabTitleDateFormat,
  );
}

// ============================================================
// INITIALIZATION
// ============================================================

function getInitialData() {
  try {
    const document = DocumentApp.getActiveDocument();
    const activeTab = document.getActiveTab();

    if (!activeTab) {
      throw new Error('Unable to identify the currently active tab.');
    }

    const documentId = document.getId();
    const tabId = activeTab.getId();

    const docsData = Docs.Documents.get(documentId, {
      includeTabsContent: true,
    });

    const allTabs = flattenTabs_(docsData.tabs || []);

    const activeTabData = allTabs.find(
      tab => tab.tabProperties.tabId === tabId,
    );

    if (!activeTabData) {
      throw new Error(`Unable to retrieve the active tab. Tab ID: ${tabId}`);
    }

    // Verify direct parent tab.
    const parentId = activeTabData.tabProperties.parentTabId || null;

    const parentTab = parentId
      ? allTabs.find(tab => tab.tabProperties.tabId === parentId)
      : null;

    const parentTitle = parentTab ? parentTab.tabProperties.title : null;

    const requiredParent = PLACEHOLDER_CONFIG.settings.requiredParentTab;

    if (parentTitle !== requiredParent) {
      return {
        showForm: false,
        eligible: false,
        warningType: 'warning',
        warning:
          `This tab is not eligible for modification. ` +
          `Please open a dedicated child tab under "${requiredParent}". ` +
          `Current parent: ${parentTitle || 'None (root tab)'}.`,
        documentName: activeTab.getTitle(),
      };
    }

    // Retrieve active tab content.
    const tabContent = activeTabData.documentTab?.body?.content || [];

    const documentText = extractTextFromContent_(tabContent);

    // Check all configured placeholders.
    const configuredPlaceholders = getConfiguredPlaceholders_();

    const missingPlaceholders = configuredPlaceholders.filter(
      placeholder => !documentText.includes(placeholder),
    );

    if (missingPlaceholders.length) {
      return {
        showForm: false,
        eligible: true,
        warningType: 'warning',
        warning:
          'This tab does not contain all the required predefined placeholders.\n\n' +
          'Missing placeholders: ' +
          missingPlaceholders.join(', '),
        documentName: activeTab.getTitle(),
      };
    }

    // Discover additional double-curly placeholders.
    const additionalPlaceholders =
      findAdditionalCurlyPlaceholders_(documentText);

    // Prepare field definitions for HTML.
    const defaults = getConfiguredDefaults_();

    const configuredFields = PLACEHOLDER_CONFIG.fields.map(field => ({
      key: field.key,
      placeholder: field.placeholder,
      title: field.title,
      defaultValue: defaults[field.key],
      additional: false,
    }));

    const additionalFields = additionalPlaceholders.map(
      (placeholder, index) => ({
        key: `additional_${index}`,
        placeholder: placeholder,
        title: getPlaceholderLabel_(placeholder),
        defaultValue: '',
        additional: true,
      }),
    );

    // Collect existing tab names.
    const existingTabTitles = allTabs
      .filter(tab => tab.tabProperties.tabId !== tabId)
      .map(tab => tab.tabProperties.title);

    // Generate the preview date independently of the DATE field.
    const tabTitleDate = getTabTitleDate_();

    // Return all data required by HTML.
    return {
      showForm: true,
      eligible: true,

      tabId: tabId,
      documentName: activeTab.getTitle(),

      settings: {
        predefinedSectionTitle:
          PLACEHOLDER_CONFIG.settings.predefinedSectionTitle,
        additionalSectionTitle:
          PLACEHOLDER_CONFIG.settings.additionalSectionTitle,
        maxTabTitleLength: PLACEHOLDER_CONFIG.settings.maxTabTitleLength,
        titleEllipsis: PLACEHOLDER_CONFIG.settings.titleEllipsis,
      },

      documentTitleConfig: PLACEHOLDER_CONFIG.documentTitle,

      fields: configuredFields,
      additionalFields: additionalFields,

      defaults: defaults,
      existingTabTitles: existingTabTitles,

      tabTitleDate: tabTitleDate,

      documentTitle: generateUniqueDocumentTitle_(
        defaults,
        existingTabTitles,
        tabTitleDate,
      ),
    };
  } catch (error) {
    return {
      showForm: false,
      eligible: false,
      warningType: 'error',
      warning: error.message || String(error),
      documentName: 'Unavailable',
    };
  }
}

// ============================================================
// TAB IDENTIFICATION
// ============================================================

function getTabInformation_(documentId, tabId) {
  const document = Docs.Documents.get(documentId, {
    includeTabsContent: true,
  });

  const tabs = flattenTabs_(document.tabs || []);

  const activeTab = tabs.find(tab => tab.tabProperties.tabId === tabId);

  if (!activeTab) {
    throw new Error(`Unable to retrieve the active tab. Tab ID: ${tabId}`);
  }

  const parentId = activeTab.tabProperties.parentTabId || null;

  const parentTab = parentId
    ? tabs.find(tab => tab.tabProperties.tabId === parentId)
    : null;

  const parentTitle = parentTab ? parentTab.tabProperties.title : null;

  return {
    tabId: tabId,
    parentId: parentId,
    parentTitle: parentTitle,
    eligible: parentTitle === PLACEHOLDER_CONFIG.settings.requiredParentTab,
  };
}

function flattenTabs_(tabs, result = []) {
  tabs.forEach(tab => {
    result.push(tab);

    if (tab.childTabs && tab.childTabs.length) {
      flattenTabs_(tab.childTabs, result);
    }
  });

  return result;
}

// ============================================================
// PLACEHOLDER DISCOVERY
// ============================================================

function findAdditionalCurlyPlaceholders_(documentText) {
  const configured = new Set(getConfiguredPlaceholders_());

  const matches = documentText.match(/\{\{[^{}\r\n]+\}\}/g) || [];

  return [...new Set(matches.filter(token => !configured.has(token)))];
}

function getPlaceholderLabel_(placeholder) {
  return placeholder.replace(/^\{\{|\}\}$/g, '');
}

// ============================================================
// UNEXPECTED PLACEHOLDER DETECTION
// ============================================================

function findUnexpectedPlaceholders_(documentText) {
  const detectedTokens = new Set();

  // Any remaining double-curly placeholders.
  const curlyMatches = documentText.match(/\{\{[^{}\r\n]+\}\}/g) || [];

  curlyMatches.forEach(token => detectedTokens.add(token));

  // Alternative delimiter patterns.
  const alternativePatterns = [
    /\{(?!\{)\s*([A-Z][A-Z0-9_]*)\s*\}(?!\})/g,
    /\[\[\s*([A-Z][A-Z0-9_]*)\s*\]\]/g,
    /\[\s*([A-Z][A-Z0-9_]*)\s*\]/g,
    /<<\s*([A-Z][A-Z0-9_]*)\s*>>/g,
    /<\s*([A-Z][A-Z0-9_]*)\s*>/g,
    /%%\s*([A-Z][A-Z0-9_]*)\s*%%/g,
    /%\s*([A-Z][A-Z0-9_]*)\s*%/g,
    /\$\s*([A-Z][A-Z0-9_]*)\s*\$/g,
    /##\s*([A-Z][A-Z0-9_]*)\s*##/g,
    /@\s*([A-Z][A-Z0-9_]*)\s*@/g,
  ];

  alternativePatterns.forEach(pattern => {
    let match;

    while ((match = pattern.exec(documentText)) !== null) {
      detectedTokens.add(match[0]);
    }
  });

  if (!detectedTokens.size) {
    return [];
  }

  return [
    'Unresolved or alternative-format placeholder-like tokens found: ' +
      [...detectedTokens].join(', '),
  ];
}

// ============================================================
// DOCUMENT TITLE GENERATION
// ============================================================

function generateUniqueDocumentTitle_(values, existingTitles, tabTitleDate) {
  const titleConfig = PLACEHOLDER_CONFIG.documentTitle;
  const settings = PLACEHOLDER_CONFIG.settings;

  const companyName = String(values[titleConfig.companyFieldKey] || '').trim();

  // The date is supplied by the script, never by the DATE field.
  const date = tabTitleDate || getTabTitleDate_();

  const existing = new Set(
    (existingTitles || []).map(title => title.toLowerCase()),
  );

  for (let iteration = 1; ; iteration++) {
    const suffix = iteration > 1 ? ` (${iteration})` : '';

    const prefix = `${companyName}${titleConfig.separator}${date}${suffix}`;

    const candidate = truncateTabTitle_(
      prefix,
      settings.maxTabTitleLength,
      settings.titleEllipsis,
    );

    if (!existing.has(candidate.toLowerCase())) {
      return candidate;
    }
  }
}

function truncateTabTitle_(title, maxLength, ellipsis) {
  const characters = Array.from(title);

  if (characters.length <= maxLength) {
    return title;
  }

  const availableLength = maxLength - Array.from(ellipsis).length;

  if (availableLength <= 0) {
    return characters.slice(0, maxLength).join('');
  }

  return characters.slice(0, availableLength).join('') + ellipsis;
}

// ============================================================
// INPUT VALIDATION
// ============================================================

function validateInputs_(values, additionalFields) {
  const missingFields = PLACEHOLDER_CONFIG.fields.filter(
    field => !String(values[field.key] ?? '').trim(),
  );

  if (missingFields.length) {
    throw new Error(
      'Please provide values for the following fields: ' +
        missingFields.map(field => field.title).join(', ') +
        '.',
    );
  }

  PLACEHOLDER_CONFIG.fields.forEach(field => {
    if (/\{\{[^{}\r\n]+\}\}/.test(String(values[field.key]))) {
      throw new Error(
        `${field.title} must not contain another placeholder token.`,
      );
    }
  });

  additionalFields.forEach(field => {
    const value = String(values[field.key] ?? '').trim();

    if (!value) {
      throw new Error(`Please provide a value for ${field.placeholder}.`);
    }

    if (/\{\{[^{}\r\n]+\}\}/.test(value)) {
      throw new Error(
        `The value for ${field.placeholder} must not contain another placeholder token.`,
      );
    }
  });
}

// ============================================================
// DOCUMENT TEXT EXTRACTION
// ============================================================

function extractTextFromContent_(content) {
  const textParts = [];

  function traverse(element) {
    if (!element || typeof element !== 'object') {
      return;
    }

    if (element.textRun && typeof element.textRun.content === 'string') {
      textParts.push(element.textRun.content);
    }

    Object.keys(element).forEach(key => {
      if (key !== 'textRun') {
        traverse(element[key]);
      }
    });
  }

  traverse(content);

  return textParts.join('');
}

// ============================================================
// PLACEHOLDER SUBSTITUTION
// ============================================================

function substitutePlaceholders(tabId, values) {
  try {
    const document = DocumentApp.getActiveDocument();
    const documentId = document.getId();
    const activeTab = document.getActiveTab();

    // Verify active tab.
    if (!activeTab || activeTab.getId() !== tabId) {
      throw new Error(
        'The active tab has changed. Close the form and reopen Automation from the intended tab.',
      );
    }

    // Retrieve latest document state.
    const latestDocument = Docs.Documents.get(documentId, {
      includeTabsContent: true,
    });

    const latestTabs = flattenTabs_(latestDocument.tabs || []);

    const targetTabData = latestTabs.find(
      tab => tab.tabProperties.tabId === tabId,
    );

    if (!targetTabData) {
      throw new Error(`Target tab not found. Tab ID: ${tabId}`);
    }

    // Verify parent tab.
    const tabInfo = getTabInformation_(documentId, tabId);

    if (!tabInfo.eligible) {
      throw new Error(
        `Substitution is permitted only inside a child tab of "${PLACEHOLDER_CONFIG.settings.requiredParentTab}".`,
      );
    }

    // Retrieve latest content.
    const originalText = extractTextFromContent_(
      targetTabData.documentTab?.body?.content || [],
    );

    // Verify all configured placeholders.
    const missingConfigured = PLACEHOLDER_CONFIG.fields.filter(
      field => !originalText.includes(field.placeholder),
    );

    if (missingConfigured.length) {
      throw new Error(
        'The following predefined placeholders were not found: ' +
          missingConfigured.map(field => field.placeholder).join(', '),
      );
    }

    // Discover additional fields again on the server.
    const additionalPlaceholders =
      findAdditionalCurlyPlaceholders_(originalText);

    const additionalFields = additionalPlaceholders.map(
      (placeholder, index) => ({
        key: `additional_${index}`,
        placeholder: placeholder,
        title: getPlaceholderLabel_(placeholder),
        additional: true,
      }),
    );

    // Validate all submitted values.
    validateInputs_(values, additionalFields);

    // Build replacement list from central configuration.
    const replacements = PLACEHOLDER_CONFIG.fields.map(field => ({
      placeholder: field.placeholder,
      value: String(values[field.key]).trim(),
    }));

    additionalFields.forEach(field => {
      replacements.push({
        placeholder: field.placeholder,
        value: String(values[field.key]).trim(),
      });
    });

    // Generate a fresh title date from the script.
    // The DATE form value is deliberately not used.
    const tabTitleDate = getTabTitleDate_();

    // Generate unique title using company name and script date.
    const existingTabTitles = latestTabs
      .filter(tab => tab.tabProperties.tabId !== tabId)
      .map(tab => tab.tabProperties.title);

    const newTitle = generateUniqueDocumentTitle_(
      values,
      existingTabTitles,
      tabTitleDate,
    );

    // Build replacement requests.
    const requests = replacements.map(item => ({
      replaceAllText: {
        containsText: {
          text: item.placeholder,
          matchCase: true,
          searchByRegex: false,
        },
        replaceText: item.value,
        tabsCriteria: {
          tabIds: [tabId],
        },
      },
    }));

    // Rename tab.
    requests.push({
      updateDocumentTabProperties: {
        tabProperties: {
          tabId: tabId,
          title: newTitle,
        },
        fields: 'title',
      },
    });

    // Execute changes.
    const response = Docs.Documents.batchUpdate(
      { requests: requests },
      documentId,
    );

    // Verify replacement counts.
    const failedReplacements = replacements.filter((item, index) => {
      const reply = response.replies[index];

      return (
        !reply ||
        !reply.replaceAllText ||
        reply.replaceAllText.occurrencesChanged < 1
      );
    });

    if (failedReplacements.length) {
      throw new Error(
        'Some placeholders could not be substituted: ' +
          failedReplacements.map(item => item.placeholder).join(', '),
      );
    }

    // Fetch updated document and inspect remaining tokens.
    const refreshedDocument = Docs.Documents.get(documentId, {
      includeTabsContent: true,
    });

    const refreshedTab = flattenTabs_(refreshedDocument.tabs || []).find(
      tab => tab.tabProperties.tabId === tabId,
    );

    if (!refreshedTab || !refreshedTab.documentTab) {
      throw new Error(`Unable to retrieve the updated tab. Tab ID: ${tabId}`);
    }

    const updatedText = extractTextFromContent_(
      refreshedTab.documentTab.body?.content || [],
    );

    // All unresolved tokens are warnings, not errors.
    const warnings = findUnexpectedPlaceholders_(updatedText);

    return {
      success: true,
      documentTitle: newTitle,
      warning: warnings.length
        ? 'Substitution completed successfully, but please review these findings:\n\n' +
          warnings.join('\n\n')
        : '',
    };
  } catch (error) {
    throw new Error(
      error.message || 'An unexpected error occurred during substitution.',
    );
  }
}
